{
  "name": "portfolio-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run db:migrate && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/db/migrate.js && node dist/server.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "factor:import": "tsx src/factordata/importKenFrench.ts",
    "market:import": "tsx src/marketdata/importYahooFinance.ts",
    "test": "vitest run src"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.1",
    "express": "4.22.1",
    "yahoo-finance2": "3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.0.10",
    "drizzle-kit": "0.31.8",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}